Find the Longest Substring That Appears at Both 

n=input("Enter string ")
for i in range(len(n)):
    if n[:len(n)-i-1]==n[i+1:]:
        print(n[:len(n)-i-1])
        break

n = input("Enter string ")

for i in range(1, len(n)):
    if n[:len(n)-i] == n[i:]:
        print(n[:len(n)-i])
        break
